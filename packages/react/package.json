{
  "name": "filecheck-react",
  "version": "0.1.0",
  "description": "React components and hooks for the Filecheck Element",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["filecheck", "react", "upload", "preflight", "element"],
  "repository": {
    "type": "git",
    "url": "https://github.com/PrintApp/filecheck-integrations.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "filecheck-js": "^0.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "filecheck-js": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
