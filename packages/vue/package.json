{
  "name": "filecheck-vue",
  "version": "0.1.1",
  "description": "Vue 3 component and composable for the Filecheck Element",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "filecheck",
    "vue",
    "nuxt",
    "upload",
    "preflight",
    "element"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PrintApp/filecheck-integrations.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "filecheck-js": "^0.1.1",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "filecheck-js": "workspace:*",
    "@vue/test-utils": "^2.4.6",
    "@vue/server-renderer": "^3.5.13",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.13"
  }
}
