{
  "name": "filecheck-node",
  "version": "0.1.2",
  "description": "Filecheck server SDK for Node.js — jobs, uploads, webhooks, and server-side job verification",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "filecheck",
    "api",
    "sdk",
    "upload",
    "preflight",
    "pdf",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PrintApp/filecheck-integrations.git",
    "directory": "packages/node"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^18.19.70",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
