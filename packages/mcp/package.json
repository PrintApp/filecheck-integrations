{
  "name": "filecheck-mcp",
  "version": "0.1.0",
  "description": "Filecheck MCP server — preflight, fix, validate, and optimize print files from AI agents",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "filecheck-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "filecheck",
    "mcp",
    "model-context-protocol",
    "preflight",
    "pdf",
    "validation",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PrintApp/filecheck-integrations.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "filecheck-node": "workspace:^",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.70",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
