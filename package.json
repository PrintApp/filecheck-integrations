{
  "name": "filecheck-integrations",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "size": "pnpm --filter @filecheck/element-js run size",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "sync:types": "node scripts/sync-element-types.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.11",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
